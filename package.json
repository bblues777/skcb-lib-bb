{
  "name": "@skcb/lib-bb",
  "version": "0.1.0",
  "description": "SurfingKeys shortcuts and search engines for ACG and adult community sites (F95zone, South Plus, 2DFan, VNDB, Cool18)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./selective.json": "./dist/selective.json",
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node dist-build/build.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@skcb/core": ">=0.2.0"
  },
  "devDependencies": {
    "@skcb/core": "link:../surfingkeys-conf-builder/packages/core",
    "@types/node": "24.0.0",
    "ajv": "8.17.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
